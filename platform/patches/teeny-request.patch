diff --git a/build/src/agents.js b/build/src/agents.js
--- a/build/src/agents.js
+++ b/build/src/agents.js
@@ -82,6 +82,31 @@
             const Agent = isHttp ? http_1.Agent : https_1.Agent;
-            exports.pool.set(key, new Agent({ ...poolOptions, keepAlive: true }));
+            // PATCH (plasmic): cap idle keep-alive socket lifetime below the GCS
+            // GFE's ~240s idle timeout, so the client closes idle sockets before
+            // the server does. Without this, reusing a server-closed socket throws
+            // ECONNRESET ("socket hang up"). See pnpm patch teeny-request.
+            exports.pool.set(key, new Agent({ ...poolOptions, keepAlive: true, timeout: 60000 }));
         }
     }
-    return exports.pool.get(key);
+    const shared = exports.pool.get(key);
+    if (!shared) {
+        return shared;
+    }
+    // GCS destroys the agent on read errors; keep other requests alive.
+    const requests = new Set();
+    return new Proxy(shared, {
+        get(target, prop) {
+            if (prop === 'destroy') {
+                return () => requests.forEach((req) => req.destroy());
+            }
+            if (prop === 'addRequest') {
+                return (req, opts) => {
+                    requests.add(req);
+                    req.once('close', () => requests.delete(req));
+                    return target.addRequest(req, opts);
+                };
+            }
+            const value = Reflect.get(target, prop, target);
+            return typeof value === 'function' ? value.bind(target) : value;
+        },
+    });
 }
