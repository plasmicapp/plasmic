    "@types/node": "^14.18.63",
    "@types/semver": "^7.8.0",
    "@types/update-notifier": "^5.1.0",
    "@types/validate-npm-package-name": "^3.0.2",
    "@types/yargs": "^16.0.11",
    "tsx": "^4.23.11"
  },
  "dependencies": {
    "@plasmicapp/cli": "0.1.373",
    "@sentry/node": "^6.2.2",
    "chalk": "^4.1.0",
    "execa": "^5.0.0",
    "glob": "^7.1.6",
    "inquirer": "^8.2.7",
