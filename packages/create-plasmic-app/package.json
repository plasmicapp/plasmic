{
  "name": "create-plasmic-app",
  "version": "0.0.169",
  "description": "Create Plasmic-powered React apps",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "packages/create-plasmic-app"
  },
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "create-plasmic-app": "./dist/index.js"
  },
  "scripts": {
    "test": "TEST_CWD=`pwd` pnpm -w test --passWithNoTests",
    "coverage": "TEST_CWD=`pwd` pnpm -w test --coverage --passWithNoTests",
    "build": "eslint 'src/**' && tsc",
    "run-cpa": "pnpm build && tsx run-cpa.ts",
    "create-plasmic-app": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/inquirer": "^8.2.13",
    "@types/jest": "^26.0.24",
