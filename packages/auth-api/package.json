{
  "version": "0.0.19",
  "description": "Framework-agnostic client for Plasmic Auth login, logout, and user session flows.",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "packages/auth-api"
  },
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "build": "pnpm build:types && pnpm build:index",
    "build:types": "tsc",
    "build:index": "node ../../build.mjs ./src/index.ts",
    "test": "TEST_CWD=`pwd` pnpm -w test --passWithNoTests",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "postpublish": "bash ../../scripts/publish-api-doc-model.sh",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "name": "@plasmicapp/auth-api",
  "author": "Chung Wu",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "dependencies": {
    "@plasmicapp/isomorphic-unfetch": "1.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "fa53f7d79f0e26d8b061102fda0c06788da6f8a7"
}
