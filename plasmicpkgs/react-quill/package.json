{
  "name": "@plasmicpkgs/react-quill",
  "version": "1.0.123",
  "description": "Plasmic registration call for react-quill WYSIWYG Editor",
  "homepage": "https://www.plasmic.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "plasmicpkgs/react-quill"
  },
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/react-quill.esm.js",
  "files": [
    "dist"
  ],
  "size-limit": [
    {
      "path": "dist/react-quill.cjs.production.min.js",
