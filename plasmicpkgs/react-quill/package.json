    },
    {
      "path": "dist/react-quill.esm.js",
      "limit": "10 KB"
    }
  ],
  "scripts": {
    "build": "tsdx build",
    "start": "tsdx watch",
    "test": "TEST_CWD=`pwd` pnpm -w test --passWithNoTests",
