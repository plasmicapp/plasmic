{
  "name": "@plasmicpkgs/fetch",
  "version": "0.0.52",
  "description": "Custom function for making HTTP requests from Plasmic data queries.",
  "homepage": "https://www.plasmic.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/plasmicapp/plasmic.git",
    "directory": "plasmicpkgs/fetch"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:types && pnpm build:index",
    "build:types": "tsc",
    "build:index": "node ../../build.mjs ./src/index.ts",
    "prepublishOnly": "npm run build",
    "postpublish": "bash ../../scripts/publish-api-doc-model.sh"
  },
  "devDependencies": {
    "@plasmicapp/host": "2.0.17",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "@plasmicapp/host": ">=1.0.211"
  }
}
